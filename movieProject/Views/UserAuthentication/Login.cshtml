@model MovieProject.Models.DTO.LoginModel
@{
}

<section class="container">
	<form class="w-40" asp-action="Login" method="post">
		<h2 class="pb-10">Login</h2>

		<div class="input-container">
			<label asp-for="UserName" class="w-40"></label>
			<input asp-for="UserName" class="input" />
		</div>
		<div class="message-box pd-x-28 error">
			<span asp-validation-for="UserName"></span>
		</div>

		<div class="input-container">
			<label asp-for="Password" class="w-40"></label>
			<input asp-for="Password" type="password" class="input" />
		</div>
		<div class="message-box pd-x-28 error">
			<span asp-validation-for="Password"></span>
		</div>

		@if (TempData["msg"] != null)
		{
			<div class="alert mb-1">
				@TempData["msg"]
			</div>
		}

		<div class="input-container">
			<button class="btn btn-default" type="submit">Login</button>
		</div>
	</form>
</section>
